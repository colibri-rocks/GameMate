<Window x:Class="GameMate.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:GameMate.Infrastructure"
        mc:Ignorable="d"
        Title="GameMate - System information"
        Width="640"
        MinHeight="240"
        MaxHeight="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left column as a card, so the two columns read as separate panels. -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="GameMate" />
                    <TextBlock Text="{Binding SoftwareVersionLabel}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Shown only when something could not be read, so the successful state stays clean. -->
                <TextBlock Margin="0,0,0,8"
                           Foreground="{DynamicResource ForegroundMutedBrush}"
                           Text="{Binding Warning}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibility}}" />

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Windows" />
                    <TextBlock Text="{Binding WindowsEdition}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource FieldLabelStyle}"
                               Text="{Binding WindowsVersion}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Graphics" />

                    <ItemsControl ItemsSource="{Binding GraphicsEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Adapter.DisplayName}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="{Binding Adapter.DriverSummary}"
                                               TextWrapping="Wrap" />

                                    <!-- Monitors driven by this adapter, indented so they sit under it. -->
                                    <ItemsControl ItemsSource="{Binding Monitors}" Margin="12,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Fixed width rather than Auto so the labels line up
                                                             whether or not a row carries the primary marker. -->
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Same star glyph the display list uses for the primary display. -->
                                                    <TextBlock Grid.Column="0"
                                                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Text="&#xE735;"
                                                               ToolTip="Primary display"
                                                               Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibility}}" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Style="{StaticResource FieldLabelStyle}"
                                                                   Text="{Binding ResolutionLabel}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Shown only when the adapter drives no output. -->
                                    <TextBlock Margin="12,6,0,0"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="No monitors connected"
                                               Visibility="{Binding HasMonitors, Converter={StaticResource InverseBooleanToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               Text="No video adapter was reported."
                               Visibility="{Binding HasVideoControllers, Converter={StaticResource InverseBooleanToVisibility}}" />
                </StackPanel>

                <!-- Only shown when the correlation failed for some monitor, so nothing disappears silently. -->
                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding HasUnmatchedMonitors, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Unmatched monitors" />

                    <ItemsControl ItemsSource="{Binding UnmatchedMonitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="{Binding ResolutionLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right column as a matching card. -->
        <Border Grid.Row="0" Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Feature matrix" />

            <!-- Features grouped by the API that provides them, so the matrix shows why a control is available. -->
            <ItemsControl ItemsSource="{Binding FeatureGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4">
                            <!-- Group heading: muted and smaller than the section header so it reads as a subgroup. -->
                            <TextBlock Margin="0,4,0,4"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Text="{Binding Name}"
                                       TextWrapping="Wrap" />

                            <!-- Indented so the rows sit visually under their group heading. -->
                            <ItemsControl ItemsSource="{Binding Features}" Margin="8,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4" MinWidth="170">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Feature}" />

                                            <!-- Tick or cross, not a CheckBox: the matrix is read-only information. -->
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Marker}"
                                                       ToolTip="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSupported}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Margin="0,0,8,0"
                    Padding="16,6"
                    Content="Copy"
                    Click="OnCopyClick"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Foreground="{DynamicResource ForegroundBrush}" />

            <!-- IsCancel closes the modal dialog; IsDefault makes Enter do the same as clicking it. -->
            <Button Padding="16,6"
                    Content="Close"
                    IsDefault="True"
                    IsCancel="True"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Foreground="{DynamicResource ForegroundBrush}" />
        </StackPanel>
    </Grid>
</Window>
