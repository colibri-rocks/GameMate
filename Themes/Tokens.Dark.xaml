<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark palette. The key set is identical to Tokens.Light.xaml on purpose: ThemeManager swaps one
        file for the other, so a key missing here would leave its consumer unthemed in dark mode.

        Values are chosen to keep text above roughly a 4.5:1 contrast ratio against the surface it sits
        on, which matters most for ForegroundMutedBrush and the disabled foregrounds.
    -->

    <!-- Window and panel surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF252526" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#FF3F3F46" />

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#FFA0A0A0" />

    <!-- Accent, lightened so it still reads against the dark surfaces -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CA0F0" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#FF2D7DD2" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />

    <!-- Generic control chrome -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF3E3E42" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF4A4A50" />
    <SolidColorBrush x:Key="ControlDisabledBackgroundBrush" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="#FF7A7A7A" />

    <!-- Sliders -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#FF4CA0F0" />

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FF55555A" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#FF6E6E75" />

    <!-- Selection highlight -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF2D4A6B" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#FFF0F0F0" />

</ResourceDictionary>
