<Window x:Class="GameMate.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:GameMate.Infrastructure"
        xmlns:loc="clr-namespace:GameMate.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Update.Window.Title}"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current state: checking, up to date, newer release, or check failed. -->
        <TextBlock Grid.Row="0"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap" />

        <!-- Determinate progress while the archive is transferred or unpacked. -->
        <ProgressBar Grid.Row="1"
                     Height="6"
                     Margin="0,12,0,0"
                     Maximum="100"
                     Minimum="0"
                     Value="{Binding Progress, Mode=OneWay}"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="{DynamicResource ControlBackgroundBrush}"
                     BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource ForegroundMutedBrush}"
                   Text="{Binding ProgressText}"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />

        <!-- A failure keeps the retry and fallback actions reachable instead of dead-ending the window. -->
        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource UpdateAvailableBrush}"
                   Text="{Binding Failure}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibility}}" />

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Padding="16,6"
                    Margin="0,0,8,0"
                    Command="{Binding InstallCommand}"
                    Content="{loc:Loc Update.Button.Install}"
                    Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource AccentBorderBrush}"
                    Foreground="{DynamicResource AccentForegroundBrush}"
                    Visibility="{Binding CanInstall, Converter={StaticResource BooleanToVisibility}}" />

            <Button Padding="16,6"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Loc Update.Button.Cancel}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibility}}" />

            <Button Padding="16,6"
                    Margin="0,0,8,0"
                    Command="{Binding CheckAgainCommand}"
                    Content="{loc:Loc Update.Button.CheckAgain}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Visibility="{Binding CanCheck, Converter={StaticResource BooleanToVisibility}}" />

            <!-- Always available: the manual path for a user who cannot or will not self-update. -->
            <Button Padding="16,6"
                    Margin="0,0,8,0"
                    Command="{Binding OpenDownloadPageCommand}"
                    Content="{loc:Loc Update.Button.OpenDownloadPage}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Foreground="{DynamicResource ForegroundBrush}" />

            <Button Padding="16,6"
                    Content="{loc:Loc Update.Button.Close}"
                    IsCancel="True"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibility}}" />
        </StackPanel>
    </Grid>
</Window>
