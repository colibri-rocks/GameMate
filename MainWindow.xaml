<Window x:Class="GameMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:GameMate.Infrastructure"
        mc:Ignorable="d"
        Title="GameMate - Display control"
        Width="920"
        MinWidth="800"
        MinHeight="360"
        SizeToContent="Height"
        MaxHeight="760"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />

        <Style x:Key="ControlLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="ControlValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="46" />
        </Style>

        <!-- Icons for the five colour settings. The font chain ends in Segoe UI Symbol so a row still
             renders a glyph if neither MDL2 nor Fluent Icons is installed. -->
        <Style x:Key="ControlIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="Display control" />

            <!-- Cycles Follow Windows -> Light -> Dark. The tooltip names both the current mode and the
                 next one, which is what keeps a three-state icon button unambiguous. -->
            <Button Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="8,4"
                    Command="{Binding CycleThemeCommand}"
                    ToolTip="{Binding ThemeTooltip}"
                    AutomationProperties.Name="{Binding ThemeTooltip}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}">
                <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol"
                           FontSize="16"
                           Foreground="{DynamicResource ForegroundBrush}"
                           Text="{Binding ThemeGlyph}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Single select display list, mirroring the selector of the NVIDIA Control Panel. -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,0,0,6"
                           Text="Select a display to change:" />

                <!-- MaxHeight caps the list at 4 rows; VerticalAlignment Top lets it stay compact while
                     fewer displays are connected, and the bar appears only once the cap is reached. -->
                <ListBox ItemsSource="{Binding Displays}"
                         SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                         SelectionMode="Single"
                         VerticalAlignment="Top"
                         MaxHeight="172"
                         Background="{DynamicResource SurfaceBrush}"
                         BorderBrush="{DynamicResource SurfaceBorderBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- A fixed row height is what makes the 4 row cap exact. -->
                            <Setter Property="Height" Value="42" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Monitor icon on every row; ControlIconStyle already carries the Segoe MDL2 font chain. -->
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource ControlIconStyle}"
                                           Text="&#xE7F4;" />

                                <StackPanel Grid.Column="1">
                                    <!-- Trimmed rather than wrapped so a long name cannot change the row height. -->
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayLabel}" />

                                    <!-- The primary row is marked with a star instead of the removed text caption. -->
                                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol"
                                               FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="&#xE735;"
                                               ToolTip="Primary display"
                                               Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Everything below edits the highlighted display only. -->
            <StackPanel Grid.Column="2" IsEnabled="{Binding HasSelection}">
                <StackPanel.Resources>
                    <Style TargetType="Slider">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Resources>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ControlIconStyle}" Text="&#xE706;" />
                    <TextBlock Grid.Column="1" Text="Brightness" Style="{StaticResource ControlLabelStyle}" />
                    <Slider Grid.Column="2"
                            Minimum="-100" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SelectedDisplay.Brightness, Mode=TwoWay}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedDisplay.Brightness}"
                               Style="{StaticResource ControlValueStyle}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ControlIconStyle}" Text="&#xE793;" />
                    <TextBlock Grid.Column="1" Text="Contrast" Style="{StaticResource ControlLabelStyle}" />
                    <Slider Grid.Column="2"
                            Minimum="-100" Maximum="100"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SelectedDisplay.Contrast, Mode=TwoWay}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedDisplay.Contrast}"
                               Style="{StaticResource ControlValueStyle}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ControlIconStyle}" Text="&#xE7B3;" />
                    <TextBlock Grid.Column="1" Text="Gamma" Style="{StaticResource ControlLabelStyle}" />
                    <Slider Grid.Column="2"
                            Minimum="0.3" Maximum="3"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding SelectedDisplay.Gamma, Mode=TwoWay}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedDisplay.Gamma, StringFormat={}{0:0.00}}"
                               Style="{StaticResource ControlValueStyle}" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ControlIconStyle}" Text="&#xE790;" />
                    <TextBlock Grid.Column="1" Text="Digital Vibrance" Style="{StaticResource ControlLabelStyle}" />
                    <Slider Grid.Column="2"
                            Minimum="{Binding SelectedDisplay.VibranceMinimum, FallbackValue=0}"
                            Maximum="{Binding SelectedDisplay.VibranceMaximum, FallbackValue=100}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsVibranceEnabled}"
                            Value="{Binding SelectedDisplay.Vibrance, Mode=TwoWay}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedDisplay.Vibrance}"
                               Style="{StaticResource ControlValueStyle}" />
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ControlIconStyle}" Text="&#xE2B1;" />
                    <TextBlock Grid.Column="1" Text="Hue" Style="{StaticResource ControlLabelStyle}" />
                    <Slider Grid.Column="2"
                            Minimum="-180" Maximum="180"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding SelectedDisplay.Hue, Mode=TwoWay}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedDisplay.Hue}"
                               Style="{StaticResource ControlValueStyle}" />
                </Grid>

                <Separator Margin="0,0,0,12" />

                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Profiles" />

                <StackPanel Orientation="Horizontal">
                    <!-- One button per slot: double click renames it in place, single click applies it. -->
                    <ItemsControl ItemsSource="{Binding ProfileSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,8,0">
                                    <Button Width="96" Height="30"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Number}"
                                            Visibility="{Binding IsEditingName, Converter={StaticResource InverseBooleanToVisibility}}">
                                        <Button.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding StartRenameCommand}" />
                                        </Button.InputBindings>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <!-- Base chrome for the inactive state. An explicit Style replaces any
                                                     implicit one, so the colours have to be stated here. -->
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                                <Style.Triggers>
                                                    <!-- DynamicResource keeps the active highlight in step after a theme
                                                         swap, which a StaticResource would not. -->
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Enter commits and Escape reverts through the key bindings; losing
                                         focus commits as well, which is wired up in the code behind. -->
                                    <TextBox Width="96" Height="30"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditingName, Converter={StaticResource BooleanToVisibility}}"
                                             IsVisibleChanged="OnProfileNameEditorVisibleChanged"
                                             LostFocus="OnProfileNameEditorLostFocus">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Width="140" Height="30" Margin="8,0,0,0"
                            Content="Reset to defaults"
                            Command="{Binding ResetToDefaultsCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource ForegroundMutedBrush}"
                       Text="{Binding NvidiaSummary}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource ForegroundMutedBrush}"
                       Text="{Binding ActiveProfileSummary}" />
        </StackPanel>
    </Grid>
</Window>
